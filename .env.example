# LegalPilot AI - Environment Configuration Example
# Copy this file to .env.local for local development.

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="LegalPilot AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Service Configuration
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
AI_REQUEST_TIMEOUT_MS=30000

# AI Provider API Keys (Server-side only — NEVER commit real secrets)
# Obtain your API key from Google AI Studio (https://aistudio.google.com)
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# Alternative Provider Keys (if adapter replaced in future)
# OPENAI_API_KEY=your_openai_api_key_here
